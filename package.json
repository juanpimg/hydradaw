{
  "name": "hydradaw",
  "private": true,
  "version": "1.0.0",
  "description": "HydraDAW — DAW multitrack 100% local en el navegador (Web Audio, sin servidor)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dom": "vitest run src/tests/dom",
    "test:browser": "node tests/browser/smoke.mjs",
    "test:all": "npm test && npm run test:dom && npm run test:browser",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.1",
    "puppeteer-core": "^24.43.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
